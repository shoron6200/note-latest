    "lg": {
      "size": 18,
      "line": 24,
      "weight": 600,
      "use": "card titles, sheet titles"
    },
    "xl": {
      "size": 22,
      "line": 28,
      "weight": 600,
      "use": "top bar title, editor title field"
    },
    "display": {
      "size": 28,
      "line": 34,
      "weight": 700,
      "use": "empty-state headline"
    }
