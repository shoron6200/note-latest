    "card": 0,
    "fab": 6,
    "sheet": 16,
    "snackbar": 6
  },
  "motion": {
    "fast": 120,
    "base": 220,
    "slow": 320,
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "_about": "ms. Respect the OS reduce-motion setting: drop to opacity fades only"
  },
  "layout": {
    "gutter": 16,
    "grid-gap": 12,
    "columns": {
      "compact": 2,
      "medium": 3,
      "expanded": 4
    },
    "breakpoints": {
      "medium": 600,
      "expanded": 900
    },
    "top-bar-height": 56,
    "fab-size": 56,
    "fab-offset": 16,
    "touch-target-min": 48,
    "sheet-max-width": 640,
    "editor-max-width": 720,
    "card-preview-lines": 8,
    "sheet-list-max-height": 420,
    "autosave-ms": 500,
    "search-debounce-ms": 200,
    "editor-body-min-height": 240
